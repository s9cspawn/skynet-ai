[Unit]
Description=Skynet Chat API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=local-ai-chat
Group=local-ai-chat
WorkingDirectory=/opt/local-ai-chat/backend
EnvironmentFile=-/etc/local-ai-chat/api.env
Environment=DATABASE_PATH=/var/lib/skynet/skynet.db
ExecStart=/usr/bin/node /opt/local-ai-chat/backend/dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=skynet
ReadWritePaths=/var/lib/skynet

[Install]
WantedBy=multi-user.target
